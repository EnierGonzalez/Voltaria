# App
APP_ENV="development"
NEXT_PUBLIC_APP_NAME="Voltaria"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database
# Use DATABASE_URL for local runtime, migrations and seed. It must be the direct Neon connection.
# Use DATABASE_POOLED_URL for Vercel/serverless runtime when available.
# Both can later point to Supabase PostgreSQL without changing application code.
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/voltaria?sslmode=require"
DATABASE_POOLED_URL="postgresql://user:password@ep-example-pooler.neon.tech/voltaria?sslmode=require"

# Internal auth
AUTH_PROVIDER="local"
AUTH_SECRET="change-me"
AUTH_SESSION_SECRET="change-me"
AUTH_SESSION_HOURS="12"
FIRST_OWNER_EMAIL="admin@voltaria.local"
FIRST_OWNER_PASSWORD="change-me-in-dev-only"
FIRST_OWNER_NAME="Voltaria Owner"

# RFID
RFID_HASH_SECRET="change-me-before-real-cards"
RFID_READER_API_KEY="dev-reader-key"

# Staging protection
STAGING_ACCESS_ENABLED="false"
STAGING_ACCESS_USERNAME="admin"
STAGING_ACCESS_PASSWORD="change-me"

# Optional
ENABLE_DEMO_TOOLS="true"

# Outlet simulator / gateway worker
WORKER_INSTANCE_ID=""
WORKER_SCOPE="all_simulated"
WORKER_PROPERTY_ID=""
WORKER_GATEWAY_CODE=""
WORKER_GATEWAY_TOKEN=""
OUTLET_SIMULATOR_POLL_INTERVAL_MS="3000"
OUTLET_SIMULATOR_METER_INTERVAL_MS="10000"

# OCPP 1.6J websocket server
OCPP_PORT="9220"
OCPP_PATH="/ocpp"

# Future provider bridge
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
