{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "noEmit": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@voltaria/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@voltaria/shared/*": [
        "../../packages/shared/src/*"
      ],
      "@voltaria/db": [
        "../../packages/db/src/index.ts"
      ],
      "@voltaria/db/*": [
        "../../packages/db/src/*"
      ],
      "@voltaria/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@voltaria/ui/*": [
        "../../packages/ui/src/*"
      ]
    },
    "esModuleInterop": true,
    "jsx": "preserve"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
